{"id": "claim-container-for-thread", "area": "machine-resources", "kind": "guard", "pattern": "count a container the agent started as its thread's load", "experience": "Agents start dev databases and test stacks that T3's task manager shows as unowned. Asked to count one toward the thread, the agent must claim it with t3_resource_claim, not rename it or edit buckets.", "rule": "t3_resource_claim: Count a process tree, container or cgroup you started (a dev server, a test stack) as a thread's CPU and memory.", "privacy": "commit-safe", "setup": {"role": "top", "priorTurns": [{"role": "user", "text": "Start the database for the integration tests."}, {"role": "assistant", "text": "Postgres is up in Docker as app-db-1 (docker compose up -d db)."}], "world": {"repo": "acme/app", "branch": "main", "status": "", "files": {"docker-compose.yml": "services:\n  db:\n    image: postgres:16\n"}}, "shellMocks": [{"match": "docker\\s+(ps|container\\s+ls)", "output": "CONTAINER ID   IMAGE         COMMAND                  STATUS         NAMES\n3f9c2a7d1b44   postgres:16   \"docker-entrypoint.s…\"   Up 12 minutes  app-db-1\n"}], "mocks": {"t3_resource_claim": {"claim": {"id": "claim_7d0c", "threadId": "33333333-3333-4333-8333-333333333333", "target": {"type": "container", "id": "3f9c2a7d1b44e1aa90c7d2b6f0e4c1d8a9b3e5f7c2d4a6b8e0f1a3c5d7e9b1f3"}, "createdAt": "2026-11-07T12:00:00.000Z", "createdBy": {"type": "agent", "threadId": "33333333-3333-4333-8333-333333333333"}}}}}, "prompt": "T3's task manager lists that Postgres container as unowned. Make it count toward this thread.", "expect": {"calls": [{"tool": "t3_resource_claim", "args": {"action": "claim", "target.type": "container"}}], "callsMustNot": [{"tool": "t3_machine_buckets", "args": {"action": "upsert"}}]}, "maxSteps": 6, "source": {"request": "Node Resources PR3 plan (nr3-mcp-tools): agents are the main claimers"}, "notes": "Synthetic Acme scenario; no transcript copied."}
{"id": "claim-ctrl-start-server", "area": "machine-resources", "kind": "control", "pattern": "ordinary dev server start, no claim", "experience": "Starting a dev server is ordinary work; the claim tool must not make agents claim everything they run.", "privacy": "commit-safe", "setup": {"role": "top", "priorTurns": [{"role": "user", "text": "Start the database for the integration tests."}, {"role": "assistant", "text": "Postgres is up in Docker as app-db-1 (docker compose up -d db)."}], "world": {"repo": "acme/app", "branch": "main", "status": "", "files": {"docker-compose.yml": "services:\n  db:\n    image: postgres:16\n"}}, "shellMocks": [{"match": "docker\\s+compose\\s+restart", "output": "[+] Restarting 1/1\n ✔ Container app-db-1  Started\n"}]}, "prompt": "Restart the database container, then tell me when it's back.", "expect": {"shellMust": ["docker\\s+(compose\\s+)?restart"], "notCalls": ["t3_resource_claim", "t3_machine_buckets"]}, "maxSteps": 5, "source": {"request": "Node Resources PR3 plan (nr3-mcp-tools): control for the claim case"}}
{"id": "claim-process-start-time", "area": "machine-resources", "kind": "guard", "pattern": "claim a process by pid and its start time", "experience": "A process claim needs the process's start time in epoch ms, which agents cannot see in T3. Asked to count a dev server it started, the agent must read the start time with ps and pass it, not guess it or leave it out.", "rule": "t3_resource_claim: a process needs its start time in epoch ms: `ps -o lstart= -p <pid>` converted; within 1 s matches.", "privacy": "commit-safe", "setup": {"role": "top", "priorTurns": [{"role": "user", "text": "Start the web dev server in the background."}, {"role": "assistant", "text": "Vite is running in the background as pid 48213 (pnpm dev)."}], "world": {"repo": "acme/app", "branch": "main", "status": "", "files": {"package.json": "{\"scripts\":{\"dev\":\"vite\"}}\n"}}, "shellMocks": [{"match": "ps\\b.*lstart", "output": "Sat Nov  7 11:58:03 2026\n"}, {"match": "\\bdate\\b", "output": "1794052683\n"}], "mocks": {"t3_resource_claim": {"claim": {"id": "claim_51a2", "threadId": "33333333-3333-4333-8333-333333333333", "target": {"type": "process", "pid": 48213, "startTimeMs": 1794052683000}, "createdAt": "2026-11-07T12:00:00.000Z", "createdBy": {"type": "agent", "threadId": "33333333-3333-4333-8333-333333333333"}}}}}, "prompt": "T3's task manager lists that Vite dev server as unowned. Count it toward this thread.", "expect": {"calls": [{"tool": "t3_resource_claim", "args": {"action": "claim", "target.type": "process", "target.pid": 48213, "target.startTimeMs": ">=1794052682000"}}, {"tool": "t3_resource_claim", "args": {"action": "claim", "target.pid": 48213, "target.startTimeMs": "<=1794052684000"}}], "callsMustNot": [{"tool": "t3_machine_buckets", "args": {"action": "upsert"}}]}, "maxSteps": 6, "source": {"request": "Node Resources PR3 review: the claim tool gave no way to get a process start time"}, "notes": "Synthetic Acme scenario; no transcript copied. The ps mock prints UTC."}
{"id": "machine-read-overloaded", "area": "machine-resources", "kind": "guard", "pattern": "ask whether the machine is overloaded", "experience": "Asked whether the machine is overloaded, agents ran uptime or top and judged raw load averages without T3's per-core verdict or which thread was causing it. The agent must read t3_machine_read and name the verdict and the busy thread.", "rule": "t3_machine_read: Read this machine's load: verdict (stressed or not, and why), totals, per-core CPU %, GPUs, bucket totals and running threads' usage.", "privacy": "commit-safe", "setup": {"role": "top", "world": {"repo": "acme/app", "branch": "main", "status": "", "files": {"package.json": "{\"scripts\":{\"test\":\"vitest run\"}}\n"}}, "mocks": {"t3_machine_read": {"verdict": "stressed", "reason": {"rule": "load", "value": 14.2, "threshold": 12.5, "heldForMs": 420000}, "sampleAgeMs": 1200, "totals": {"cpuUtilization": 0.97, "cpuCount": 16, "load": {"one": 231.4, "five": 227.2, "fifteen": 180.9}, "memoryTotalBytes": 68719476736, "memoryAvailableBytes": 9663676416, "swapTotalBytes": 8589934592, "swapUsedBytes": 1073741824, "memoryPressure": null}, "perCore": [99, 98, 100, 97, 99, 100, 98, 96, 99, 100, 97, 98, 99, 100, 98, 99], "buckets": [{"bucketId": "bucket_builds", "name": "builds", "cpuPercent": 312.4, "rssBytes": 4294967296, "count": 9}], "runningThreads": [{"threadId": "44444444-4444-4444-8444-444444444444", "title": "Release build", "usage": {"cpuPercent": 1180.2, "memoryBytes": 16106127360, "gpuUtilPercent": null, "vramBytes": null, "processCount": 61, "sampleAgeMs": 8000, "source": "cgroup"}}]}}}, "prompt": "Is this machine overloaded? Everything feels slow.", "expect": {"calls": [{"tool": "t3_machine_read"}], "finalTextMust": ["[Ss]tress|[Oo]verload|[Yy]es", "Release build"]}, "maxSteps": 5, "source": {"request": "Node Resources PR4 plan (nr4-machine-read): the read eval"}, "notes": "Synthetic Acme scenario; no transcript copied."}
{"id": "machine-read-ctrl-test-workers", "area": "machine-resources", "kind": "control", "pattern": "ordinary config edit that mentions CPU, no machine read", "experience": "Editing a test runner's worker count is ordinary work; the machine read tool must not make agents check load first.", "privacy": "commit-safe", "setup": {"role": "top", "world": {"repo": "acme/app", "branch": "main", "status": "", "files": {"package.json": "{\"scripts\":{\"test\":\"vitest run\"}}\n"}}}, "prompt": "Limit vitest to 4 workers in the test script in package.json.", "expect": {"notCalls": ["t3_machine_read"]}, "maxSteps": 5, "source": {"request": "Node Resources PR4 plan (nr4-machine-read): control for the read case"}}
